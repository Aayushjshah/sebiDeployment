FROM xynehq/xyne:latest



USER root



COPY certs/socnoc.crt /usr/local/share/ca-certificates/socnoc.crt



RUN chmod 0644 /usr/local/share/ca-certificates/socnoc.crt \
   && update-ca-certificates \
   && sed -i 's|exec bun backendv2/server.ts|exec bun --use-system-ca backendv2/server.ts|' /usr/src/app/start-v2.sh \
   && grep -q 'exec bun --use-system-ca backendv2/server.ts' /usr/src/app/start-v2.sh



ENV BUN_OPTIONS=--use-system-ca



USER bun
